#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp CAPSLOCK    &kp N1        &kp N2  &kp N3    &kp N4     &kp N5  &kp CARET                                                            &kp DOLLAR     &kp N6  &kp N7         &kp N8     &kp N9     &kp N0         &kp RA(RS(SINGLE_QUOTE))
&trans          &kp Q         &kp W   &kp E     &kp R      &kp T   &kp UP_ARROW                                                         &kp RA(GRAVE)  &kp Y   &kp U          &kp I      &kp O      &kp P          &kp RA(APOSTROPHE)
&kp TAB         &kp A         &kp S   &kp D     &kp F      &kp G   &kp DOWN      &kp LCTRL  &sl 2             &sl 2          &kp RCTRL  &kp ASTERISK   &kp H   &kp J          &kp K      &kp L      &kp SEMI       &kp SQT
&kp ESCAPE      &kp Z         &kp X   &kp C     &kp V      &kp B                            &kp LEFT_GUI      &kp LEFT_GUI                             &kp N   &kp M          &kp COMMA  &kp DOT    &kp MINUS      &kp EQUAL
&kp LEFT_SHIFT  &kp LEFT_ALT  &sl 3   &kp LEFT  &kp RIGHT          &kp BSPC      &sl 1      &kp DEL           &kp RIGHT_ALT  &kp ENTER  &kp SPACE              &kp BACKSLASH  &kp UNDER  &kp SLASH  &kp RIGHT_ALT  &kp RIGHT_SHIFT
            >;
        };

        sym {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2         &kp F3                &kp F4         &kp F5                 &kp F6            &kp RA(NUMBER_6)                                      &kp RA(N5)           &kp F7        &kp F8       &kp F9         &kp F10      &kp F11  &kp F12
&trans  &kp GRAVE      &kp LEFT_PARENTHESIS  &kp ASTERISK   &kp RIGHT_PARENTHESIS  &kp TILDE         &trans                                                &kp RA(EXCLAMATION)  &kp EXCL      &kp PIPE     &kp AMPERSAND  &kp CARET    &trans   &trans
&trans  &kp LESS_THAN  &kp LEFT_BRACKET      &kp PLUS       &kp RIGHT_BRACKET      &kp GREATER_THAN  &trans            &trans  &trans      &trans  &trans  &kp RA(SLASH)        &kp QUESTION  &kp PERCENT  &kp DOLLAR     &kp AT_SIGN  &trans   &trans
&trans  &trans         &kp LEFT_BRACE        &kp RA(COMMA)  &kp RIGHT_BRACE        &trans                                      &trans      &trans                               &kp RA(N)     &kp HASH     &trans         &trans       &trans   &trans
&trans  &trans         &trans                &trans         &trans                                   &trans            &trans  &trans      &trans  &trans  &trans                             &trans       &trans         &trans       &trans   &trans
            >;

            label = "symbol_layer";
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp F1  &kp F2  &kp F3    &kp F4        &kp F5     &kp F6  &trans                                      &trans  &kp F7  &kp F8        &kp F9        &kp F10       &kp F11  &kp F12
&trans  &trans  &trans    &kp UP_ARROW  &trans     &trans  &trans                                      &trans  &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans   &trans
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans   &trans
&trans  &trans  &trans    &trans        &trans     &trans                  &trans      &trans                  &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans   &trans
&trans  &trans  &trans    &trans        &trans             &trans  &trans  &trans      &trans  &trans  &trans          &kp NUMBER_0  &trans        &kp PERIOD    &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none           &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none           &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &none            &none           &none       &none       &none  &none  &none
&none           &none         &none         &caps_word    &none         &none                             &none      &none                                    &kp KP_NUMLOCK  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                  &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
